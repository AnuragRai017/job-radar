---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Signal lost — RoleRadar"
  description="That page isn’t on the radar. Head back to the job feed."
>
  <div class="shell detail-shell">
    <div class="state-card" style="margin-top: 48px; padding-block: 80px;">
      <p class="eyebrow">404 · off the radar</p>
      <h3 style="font-size: 2.2rem;">Signal lost.</h3>
      <p>
        The page you asked for doesn’t exist or has moved. The job feed is still
        sweeping — head back and search the latest public roles.
      </p>
      <a class="btn btn-primary" href="/">Back to the feed</a>
    </div>
  </div>
</BaseLayout>
