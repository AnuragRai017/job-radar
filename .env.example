# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Host ports for Docker Compose. Both bind to 127.0.0.1 only.
API_HOST_PORT=5200
FRONTEND_HOST_PORT=5100

# SQLite locally, PostgreSQL in Docker Compose.
# Local:  sqlite:///./data/jobs.db
# Docker: postgresql+psycopg://roleradar:roleradar_dev@db:5432/roleradar
# Compose builds its own DATABASE_URL from the POSTGRES_* values at the bottom,
# so this line only affects local (non-Docker) runs.
DATABASE_URL=sqlite:///./data/jobs.db

API_HOST=0.0.0.0
API_PORT=5200
CORS_ORIGINS=http://localhost:5100,http://127.0.0.1:5100,http://localhost:4321,http://127.0.0.1:4321

# ---------------------------------------------------------------------------
# Scraping
# ---------------------------------------------------------------------------
# Comma-separated. The fast India/new sources run first so the UI fills early.
# amazon, concentrix, mckinsey, kpmg_india, microsoft, hsbc, medallion, cadence,
# kpmg_gs, pwc_india, capgemini_india, exl, deloitte_india, ey, jpmorgan,
# deloitte, capgemini, google
SCRAPE_SOURCES=amazon,concentrix,mckinsey,kpmg_india,microsoft,hsbc,medallion,cadence,kpmg_gs,pwc_india,capgemini_india,exl,deloitte_india,ey,jpmorgan,deloitte,capgemini,google
SCRAPE_INTERVAL_HOURS=6
SCRAPE_ON_STARTUP=true
# 0 = no limit. Useful for a first smoke test: 25
SCRAPE_MAX_JOBS_PER_SOURCE=0
# 0 = use each scraper's safe default page ceiling
SCRAPE_MAX_PAGES_PER_SOURCE=0

HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=4
HTTP_RATE_LIMIT_SECONDS=1.5
HTTP_BACKOFF_BASE_SECONDS=2.0
HTTP_BACKOFF_MAX_SECONDS=30.0

# Respect robots.txt. Google disallows ?page= pagination, so with strict
# robots the Google scraper fetches the allowed first results page only.
RESPECT_ROBOTS=true
ROBOTS_CACHE_SECONDS=86400

# Explicit, logged exception for Google pagination. Review robots.txt and the
# site terms before enabling. See README "Compliance notes".
GOOGLE_PAGINATION_OVERRIDE=false

# Optional Selenium-Driverless fallback for HTML endpoints that keep returning
# 403/429. Requires the optional requirements-browser.txt and a Chrome install.
ENABLE_DRIVERLESS_FALLBACK=false
DRIVERLESS_HEADLESS=true

# ---------------------------------------------------------------------------
# Optional Ollama AI extraction fallback
# ---------------------------------------------------------------------------
# Disabled by default. When enabled, RoleRadar still runs its deterministic
# parsers first and only asks Ollama for Deloitte pages that yielded no
# listings or no usable JobPosting JSON-LD description.
AI_FALLBACK_ENABLED=false

# Ollama on the Docker host. Compose adds the host-gateway mapping for Linux.
# On Linux, make sure Ollama listens beyond loopback (OLLAMA_HOST=0.0.0.0).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# The host currently has gpt-oss:120b-cloud installed. This forwards page
# content to ollama.com. Use a local tag such as gpt-oss:120b if you need
# page content to stay on this machine.
OLLAMA_MODEL=gpt-oss:120b-cloud

# Per-request timeout, context window, and the per-scrape-run safeguards.
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=32768
AI_FALLBACK_MAX_CALLS=10
AI_FALLBACK_MAX_INPUT_CHARS=60000

# ---------------------------------------------------------------------------
# Resume fit scoring (local Ollama model)
# ---------------------------------------------------------------------------
# Scores every active job heuristically and the best candidates with the local
# model. No resume text leaves this machine. Put the resume under ./data and
# keep it out of git (the data/ directory is ignored).
FIT_SCORE_ENABLED=true
FIT_LLM_ENABLED=true
FIT_SCORE_AFTER_SCRAPE=false
RESUME_PATH=/app/data/Anurag_Rai_Resume.docx
# Cloud model: gpt-oss:120b-cloud forwards resume/job text to ollama.com.
# For fully local scoring, change this to mistral:7b-instruct or llama3.2:3b
# (slower on CPU-only hosts).
FIT_MODEL=gpt-oss:120b-cloud
FIT_MAX_JOBS=300
FIT_MIN_HEURISTIC=30
FIT_LLM_TIMEOUT_SECONDS=120
FIT_LLM_NUM_CTX=8192
FIT_RUN_TIMEOUT_SECONDS=3600
FIT_DESCRIPTION_CHARS=6000

# ---------------------------------------------------------------------------
# Docker Compose / PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=roleradar
POSTGRES_USER=roleradar
POSTGRES_PASSWORD=roleradar_dev
